package templ

import (
	"fmt"
	"seesharpsi/web_roguelike/game"
)

// wallColor is a helper function to map wall types to CSS variable names.
func wallColor(wallType string) string {
	switch wallType {
	case "empty":
		return "var(--wall-empty)"
	case "door":
		return "var(--wall-door)"
	case "indestructible":
		return "var(--wall-indestructible)"
	case "destructible":
		return "var(--wall-destructible)"
	default:
		return "var(--wall-indestructible)" // A fallback for any unknown wall type
	}
}

templ MapGrid(m game.Map, p game.Player) {
	// Create the grid container.
	// We use an inline style to set the grid dimensions based on the map's width and length.
	@ThemeVariables("rose-pine")
	<div
		class="map-grid"
		style={ fmt.Sprintf("grid-template-columns: repeat(%d, 60px); grid-template-rows: repeat(%d, 60px);", m.Width, m.Length) }
	>
		// We loop from top to bottom (y = Length-1 to 0) to make (0,0) appear at the bottom-left.
		for y := m.Length - 1; y >= 0; y-- {
			// Then we loop from left to right (x = 0 to Width-1).
			for x := 0; x < m.Width; x++ {
				// Check if a room has been explored at the current coordinate (x, y).
				{{ current_pos := game.Pos{X: x, Y: y} }}
				if room, explored := m.Explored[current_pos]; explored {
					// If a room has been explored, create a div for it.
					// We use an inline style to set the specific border colors for each of the four walls.
					<div
						class="room-cell"
						style={
							"border-top-color: " + wallColor(room.NWall.Type) + ";" +
							"border-right-color: " + wallColor(room.EWall.Type) + ";" +
							"border-bottom-color: " + wallColor(room.SWall.Type) + ";" +
							"border-left-color: " + wallColor(room.WWall.Type) + ";"
						}
					>
						// Check what's in this room
						{{ hasPlayer := current_pos.X == p.Position.X && current_pos.Y == p.Position.Y }}
						{{ enemyHealth := 0 }}
						{{ enemyDirection := "" }}
						for _, enemy := range m.Enemies {
							if enemy.Position.X == current_pos.X && enemy.Position.Y == current_pos.Y && enemy.Alive {
								{{ enemyHealth = enemy.Health }}
								{{ enemyDirection = enemy.NextMove }}
								{{ break }}
							}
						}
						{{ hasBomb := false }}
						for _, bombPos := range m.Bombs {
							if bombPos.X == current_pos.X && bombPos.Y == current_pos.Y {
								{{ hasBomb = true }}
								{{ break }}
							}
						}
						{{ hasPlacedBomb := false }}
						{{ bombTurns := 0 }}
						for _, placedBomb := range m.PlacedBombs {
							if placedBomb.Position.X == current_pos.X && placedBomb.Position.Y == current_pos.Y {
								{{ hasPlacedBomb = true }}
								{{ bombTurns = placedBomb.TurnsLeft }}
								{{ break }}
							}
						}

						if hasPlayer {
							<div style="width: 20px; height: 20px; background-color: var(--player-color); margin: 20px auto;"></div>
						} else if enemyHealth > 0 {
							<div style="position: relative; display: inline-block; width: 24px; height: 24px;">
								<span style="color: var(--enemy-color); position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">{enemyHealth}</span>
								if enemyDirection != "" {
									if enemyDirection == "north" {
										<span style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); color: var(--enemy-color); font-weight: 900; font-size: 14px;">^</span>
									} else if enemyDirection == "south" {
										<span style="position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%) rotate(90deg); color: var(--enemy-color); font-weight: 900; font-size: 14px;">&gt;</span>
									} else if enemyDirection == "east" {
										<span style="position: absolute; top: 50%; right: -6px; transform: translateY(-50%); color: var(--enemy-color); font-weight: 900; font-size: 14px;">&gt;</span>
									} else if enemyDirection == "west" {
										<span style="position: absolute; top: 50%; left: -6px; transform: translateY(-50%); color: var(--enemy-color); font-weight: 900; font-size: 14px;">&lt;</span>
									}
								}
							</div>
						} else if hasPlacedBomb {
							{bombTurns}
						} else if hasBomb {
							B
						}
					</div>
				} else {
					// If no room has been explored, create an empty, grayed-out cell as a placeholder.
					<div class="empty-cell"></div>
				}
		}
	}
</div>
}

templ Map(m game.Map, p game.Player) {
	<div class="game-map">
	<script type="text/javascript" src="/static/htmx.min.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			document.addEventListener('keydown', function(event) {
				let direction = null;

				switch(event.key) {
					case 'ArrowUp':
					case 'k':           // Vim: up
						direction = 'north';
						break;
					case 'ArrowDown':
					case 'j':           // Vim: down
						direction = 'south';
						break;
					case 'ArrowLeft':
					case 'h':           // Vim: left
						direction = 'west';
						break;
					case 'ArrowRight':
					case 'l':           // Vim: right
						direction = 'east';
						break;
					case ' ':           // Spacebar for bomb placement
					case 'b':           // 'b' for bomb placement
						direction = 'place_bomb';
						break;
				}

				if (direction) {
					event.preventDefault();
					// Trigger HTMX request
					htmx.ajax('GET', '/move?direction=' + direction, {
						target: '.game-map',
						swap: 'outerHTML'
					});
				}
			});
		});
	</script>
	@ThemeVariables("rose-pine")
	<style>
		.map-grid {
			display: grid;
			background-color: var(--bg-primary);
            max-width: fit-content;
            gap: 2px;
			// The grid dimensions are set dynamically via an inline style attribute.
		}
		.room-cell, .empty-cell {
			width: 60px;
			height: 60px;
			box-sizing: border-box; /* Ensures padding and border are included in the element's total width and height */
		}
		.room-cell {
			background-color: var(--room-bg);
			border-style: solid;
			border-width: 2px; /* A nice, thick border to be visible */
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: bold;
			font-size: 18px;
			color: var(--player-color);
		}
		.empty-cell {
			background-color: var(--room-unexplored);
		}
	</style>

	@MapGrid(m, p)

<div style="margin-top: 20px; text-align: center;">
	<div style="display: inline-block;">
		<div style="margin-bottom: 10px;">
			<button
				hx-get="/move?direction=north"
				hx-target=".game-map"
				hx-swap="outerHTML"
				style="width: 60px; height: 40px; margin: 0 5px;"
			>↑</button>
		</div>
		<div>
			<button
				hx-get="/move?direction=west"
				hx-target=".game-map"
				hx-swap="outerHTML"
				style="width: 60px; height: 40px; margin: 0 5px;"
			>←</button>
			<button
				hx-get="/move?direction=east"
				hx-target=".game-map"
				hx-swap="outerHTML"
				style="width: 60px; height: 40px; margin: 0 5px;"
			>→</button>
		</div>
		<div style="margin-top: 10px;">
			<button
				hx-get="/move?direction=south"
				hx-target=".game-map"
				hx-swap="outerHTML"
				style="width: 60px; height: 40px; margin: 0 5px;"
			>↓</button>
		</div>
	</div>
</div>

<div style="margin-top: 15px; text-align: center;">
	<button
		hx-get="/move?direction=place_bomb"
		hx-target=".game-map"
		hx-swap="outerHTML"
		style="width: 80px; height: 40px; background-color: var(--enemy-color); color: white; border: none; border-radius: 4px; font-weight: bold;"
	>💣 BOMB</button>
</div>

<div style="margin-top: 20px; text-align: center; font-size: 18px; font-weight: bold; color: var(--player-color);">
	Health: {p.Health}
</div>

<div style="margin-top: 10px; text-align: center; font-size: 16px; color: var(--text-secondary);">
	Bombs: {len(p.Items)}
</div>

<div style="margin-top: 20px; text-align: center;">
	<div style="display: inline-block; text-align: left;">
		<div style="font-weight: bold; margin-bottom: 10px;">Wall Types:</div>
		<div style="display: flex; flex-direction: column; gap: 5px;">
			<div style="display: flex; align-items: center; gap: 10px;">
				<div style="width: 20px; height: 20px; border: 2px solid var(--wall-empty); background-color: var(--room-bg);"></div>
				<span>Empty</span>
			</div>
			<div style="display: flex; align-items: center; gap: 10px;">
				<div style="width: 20px; height: 20px; border: 2px solid var(--wall-door); background-color: var(--room-bg);"></div>
				<span>Door</span>
			</div>
			<div style="display: flex; align-items: center; gap: 10px;">
				<div style="width: 20px; height: 20px; border: 2px solid var(--wall-indestructible); background-color: var(--room-bg);"></div>
				<span>Indestructible</span>
			</div>
			<div style="display: flex; align-items: center; gap: 10px;">
				<div style="width: 20px; height: 20px; border: 2px solid var(--wall-destructible); background-color: var(--room-bg);"></div>
				<span>Destructible</span>
			</div>
		</div>
	</div>
</div>
	</div>
}

